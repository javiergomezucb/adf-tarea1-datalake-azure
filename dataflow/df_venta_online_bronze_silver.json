{
	"name": "df_venta_online_bronze_silver",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_sc_limpia_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          {customer/name} as string,",
				"          {customer/email} as string,",
				"          {customer/city} as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string,",
				"          customer as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(order_id = trim(order_id)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          id_orden = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          nombre_cliente = {customer/name},",
				"          email_cliente = {customer/email},",
				"          cuidad_cliente = {customer/city},",
				"          metodo_pago = payment_method,",
				"          status,",
				"          costo_envio = shipping_cost,",
				"          canal = channel,",
				"          cliente = customer",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(fecha = coalesce(\r",
				"toDate(fecha, 'yyyy-MM-dd'),\r",
				"toDate(fecha, 'dd-MM-yyyy'),\r",
				"toDate(fecha, 'MM-dd-yyyy'),\r",
				"toDate(fecha, 'dd/MM/yyyy'),\r",
				"toDate(fecha, 'yyyy/MM/dd'),\r",
				"toDate(fecha, 'dd-MMM-yyyy'),\r",
				"toDate(fecha, 'dd-MMM-yyyy'))) ~> derivedColumn2",
				"derivedColumn2 derive(precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]', ''))) ~> derivedColumn3",
				"derivedColumn3 derive(cuidad_cliente = upper(left(cuidad_cliente, 1)) + lower(substring(cuidad_cliente, 2))) ~> derivedColumn4",
				"derivedColumn4 derive(email_cliente = iif(\r",
				"    isNull(email_cliente) || !regexMatch(trim(email_cliente), '^[^@\\\\s]+@[^@\\\\s]+\\\\.[^@\\\\s]+$'),\r",
				"    toString(null()),\r",
				"    lower(translate(trim(email_cliente), 'áéíóúüñÁÉÍÓÚÜÑ', 'aeiouunaeiouun'))\r",
				")) ~> derivedColumn5",
				"derivedColumn5 derive(precio_unitario = toInteger(precio_unitario),",
				"          cantidad = toInteger(cantidad)) ~> derivedColumn6",
				"derivedColumn6 filter(cantidad>0 && !isNull(precio_unitario) && !isNull(fecha)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['ventas_online_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}